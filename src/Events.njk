---
layout: meeting.njk
title: Upcoming Events
date: Last Modified
permalink: /Events/
description: Local, Iowa, and Online events
featuredImage: ""
---

<div class="columns is-multiline is-centered is-variable is-1 events-gallery">
  {% if upcomingEvents.length %}
    {% for event in upcomingEvents %}
      <div class="column is-half is-one-third-tablet is-one-quarter-widescreen">
        <article class="card event-card">
          <div class="card-image">
            <figure class="image is-4by3 event-thumbnail">
              <a href="{{ event.src }}" target="_blank" rel="noopener" aria-label="Open {{ event.title }}" title="Click thumbnail to view original size">
                <img src="{{ event.src }}" alt="{{ event.title }} event flyer" loading="lazy">
              </a>
            </figure>
          </div>
          <div class="card-content event-caption">{{ event.title }}</div>
        </article>
      </div>
    {% endfor %}
  {% else %}
    <div class="column">
      <p>Information about upcoming local Al-Anon events will be posted here as it becomes available.</p>
    </div>
  {% endif %}
</div>

<details class="mt-6">
  <summary class="title is-3 is-size-5-mobile has-text-weight-bold">Past Events</summary>
  <h3 class="subtitle is-size-4 has-text-grey-dark has-text-weight-light is-family-sans-serif">
    Local, Iowa, and Online events for Ames, IA and surrounding areas
  </h3>

  <div class="columns is-multiline is-centered is-variable is-1 events-gallery">
    {% if pastEvents.length %}
      {% for event in pastEvents %}
        <div class="column is-half is-one-third-tablet is-one-quarter-widescreen">
          <article class="card event-card">
            <div class="card-image">
              <figure class="image is-4by3 event-thumbnail">
                <a href="{{ event.src }}" target="_blank" rel="noopener" aria-label="Open {{ event.title }}" title="Click thumbnail to view original size">
                  <img src="{{ event.src }}" alt="{{ event.title }} event flyer" loading="lazy">
                </a>
              </figure>
            </div>
            <div class="card-content event-caption">{{ event.title }}</div>
          </article>
        </div>
      {% endfor %}
    {% else %}
      <div class="column">
        <p>Past events will be listed here.</p>
      </div>
    {% endif %}
  </div>
</details>